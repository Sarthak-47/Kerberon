# Project-local Go environment (CLAUDE.md R2) — never committed.
.toolchain/
.gopath/
.gocache/
.tmp/

# Vendored dependencies are reproducible from go.mod + go.sum and are not
# committed: modernc.org/sqlite ships transpiled C for every platform, so
# vendor/ is ~133 MB and each dependency bump would add that again, permanently,
# to git history. Regenerate on demand with `go mod vendor`. See DECISIONS D11.
vendor/

# Build output
/dist/
/kerberon
/kerberon.exe
/kerberon-bench
/kerberon-bench.exe

# Runtime state — SQLite database and its WAL/shm sidecars
*.db
*.db-wal
*.db-shm

# Local config that may hold real credentials.
# examples/ is committed; a top-level kerberon.yaml is the operator's own.
/kerberon.yaml
*.local.yaml
.env

# Editors / OS
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini
